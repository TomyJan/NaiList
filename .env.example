# Docker 和裸跑共用配置；自动加载工作目录的 .env，环境变量优先
DATABASE_URL=postgres://nailist:替换为密码@postgres.example.com:5432/nailist?sslmode=verify-full
PUBLIC_URL=https://群列表域名
PORT=8080
LOG_LEVEL=info

# 客户端 IP 请求头，如 X-Forwarded-For、CF-Connecting-IP 或 X-Real-IP；留空使用连接 IP
CLIENT_IP_HEADER=

# 站点管理员的内部账号 ID（逗号分隔，个人管理页可查看；留空关闭管理区）
ADMIN_USER_IDS=

# Umami（同时留空不启用；修改后重启生效，无需重编前端）
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# 页脚访问统计（独立配置；留空隐藏，填写 Umami 网站分享链接）
# 分享最少开启「流量 → 概览」；修改后重启，无需重编
UMAMI_SHARE_URL=

# QQ 登录（留空不启用）
QQ_APP_ID=
QQ_APP_KEY=
QQ_USE_UNIONID=false

# OIDC 登录（整组全部留空不启用；启用须填写 ID、NAME、ISSUER、CLIENT_ID）
# 已有绑定后保持 ID 和 ISSUER 不变；图标、客户端密钥和额外 scopes 可留空
OIDC_ID=
OIDC_NAME=
OIDC_ICON=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
