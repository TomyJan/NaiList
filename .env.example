# Docker 和裸跑共用配置；自动加载工作目录的 .env，环境变量优先
DATABASE_URL=postgres://nailist:替换为密码@postgres.example.com:5432/nailist?sslmode=disable
PUBLIC_URL=https://群列表域名
PORT=8080

# Umami（同时留空不启用；修改后重启生效，无需重编前端）
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# QQ 登录（留空不启用）
QQ_APP_ID=
QQ_APP_KEY=
QQ_USE_UNIONID=false

# OIDC 登录（ID 留空不启用，已有绑定后保持 ID 不变）
OIDC_ID=
OIDC_NAME=
OIDC_ICON=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
