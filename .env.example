# Docker 和裸跑共用配置；裸跑自动加载当前工作目录的 .env，环境变量优先
POSTGRES_PASSWORD=替换为随机长密码
PUBLIC_URL=https://群列表域名
QQ_APP_ID=
QQ_APP_KEY=
QQ_USE_UNIONID=false

# 可选：一个 OIDC 登录方式（ID 配置后保持不变）
OIDC_ID=
OIDC_NAME=
OIDC_ICON=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
APP_PORT=8080

# 可选：完整连接串优先于 POSTGRES_*；默认用户和数据库名均为 nailist
# DATABASE_URL=postgres://nailist:密码@127.0.0.1:5432/nailist?sslmode=disable
# 裸跑默认连接 127.0.0.1:5432；Compose 默认连接 db:5432
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# 裸跑默认监听 :APP_PORT；Compose 内部监听 :8080，对外映射 APP_PORT
# LISTEN_ADDR=127.0.0.1:8080
# 默认使用二进制内嵌前端；仅需要外置覆盖时设置
# WEB_DIR=/path/to/web/dist
